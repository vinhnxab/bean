#!/usr/bin/env bash
# Khởi động Bean — đảm bảo CHỈ CÓ MỘT tiến trình bean trong một thời điểm.
#
# Vì sao cần script: hai tiến trình cùng đọc `data.dir` sẽ tranh nhau SQLite và
# scheduler, dễ sinh "database is locked" và task chạy hai lần.
#
# M29: key KHÔNG còn được nạp vào môi trường tiến trình từ ~/.config/bean/env —
# Bean tự đọc `data.dir/secrets.env` (0600) theo thứ tự env > secrets.env. Nếu key
# cũ vẫn nằm trong file env, chạy một lần:
#   bean config migrate-secrets --apply
#
# Cách dùng:
#   beanctl start     # dừng instance cũ (nếu có) rồi khởi động mới
#   beanctl stop      # dừng hẳn
#   beanctl status    # xem đang chạy gì
#   beanctl restart   # = stop + start
#   beanctl run       # chạy FOREGROUND — dành cho systemd user service làm supervisor

set -uo pipefail

REPO="/home/bean/dev/bean"
BIN="$REPO/target/release/bean"
CONFIG="$REPO/bean.toml"
ENV_FILE="$HOME/.config/bean/env"
LOG="/tmp/bean-run/serve.log"

# Khi unit systemd user đã cài (~/.config/systemd/user/bean.service), các lệnh
# vòng đời delegate sang systemctl để systemd làm supervisor duy nhất — tránh
# double-instance (K27) và giúp `bean update` (M30) restart đúng đường sau khi
# cài bản mới. Lệnh `run` vẫn là ExecStart của unit, không đổi.
UNIT="bean.service"
UNIT_FILE="$HOME/.config/systemd/user/$UNIT"
unit_installed() { [ -f "$UNIT_FILE" ]; }
unit_active() { systemctl --user is-active --quiet "$UNIT" 2>/dev/null; }

# Chạy Bean nền, tách phiên terminal (nó sống sót sau khi terminal đóng) và
# tách luôn stdin. `setsid` quan trọng: không có nó thì SIGHUP của terminal sẽ
# giết Bean khi bạn đóng cửa sổ.
# M29: KHÔNG nạp ENV_FILE vào môi trường — Bean tự đọc secrets.env.
launch() {
  mkdir -p "$(dirname "$LOG")"
  (
    # Đường dẫn tương đối trong bean.toml (workspace, skills) giải theo CWD của
    # tiến trình — luôn cd về repo để workspace không đổi theo nơi gọi beanctl.
    cd "$REPO" || exit 1
    export RUST_LOG="${RUST_LOG:-info,bean_security=warn}"
    exec setsid "$BIN" --config "$CONFIG" serve >>"$LOG" 2>&1 </dev/null
  ) &
  disown
}

# Tiến trình Bean thật của repo này: cmdline chứa pattern là chưa đủ — shell gọi
# beanctl có thể mang cùng chuỗi đó (vd `sh -c 'beanctl stop && pgrep -f ...'`) và
# bị nhầm là Bean (báo động giả 15s + SIGKILL oan shell gọi lệnh). Đối chiếu
# /proc/<pid>/exe với $BIN mới là nhận diện đúng.
bean_pids() {
  local pid exe
  for pid in $(pgrep -f "target/release/bean --config" 2>/dev/null || true); do
    [ "$pid" = "$$" ] && continue
    exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null) || continue
    [ "$exe" = "$BIN" ] && echo "$pid"
  done
}

# stop_all [quiet] — dừng tiến trình Bean ngoài systemd. quiet: im khi không có gì để dừng.
stop_all() {
  local quiet="${1:-}" pids alive pid state
  pids=$(bean_pids | tr '\n' ' ')
  pids="${pids% }"
  if [ -z "$pids" ]; then
    [ -n "$quiet" ] || echo "Không có tiến trình Bean nào đang chạy."
    return 0
  fi
  echo "Đang dừng: $(echo "$pids" | tr '\n' ' ')"
  # SIGTERM để Bean tắt êm (đóng SQLite, huỷ task con). Chờ tối đa 15s rồi mới ép.
  # Chỉ theo dõi đúng các pid đã thu — pgrep tươi sẽ khớp lại shell gọi lệnh.
  kill -TERM $pids 2>/dev/null
  for _ in $(seq 1 15); do
    alive=""
    for pid in $pids; do
      state=$(cut -d' ' -f3 "/proc/$pid/stat" 2>/dev/null) || continue
      [ "$state" = "Z" ] && continue   # zombie: đã chết, chỉ chờ parent reap
      alive="1"
    done
    [ -z "$alive" ] && { echo "Đã dừng êm."; return 0; }
    sleep 1
  done
  echo "Không phản hồi SIGTERM trong 15s — dùng SIGKILL."
  kill -KILL $pids 2>/dev/null
  sleep 1
}

check_secrets() {
  # M29: cảnh báo mềm (không chặn — provider tự host không cần key).
  local dir="$(grep -m1 -E '^[[:space:]]*dir[[:space:]]*=' "$CONFIG" 2>/dev/null \
    | sed -E 's/^[^=]*=[[:space:]]*"([^"]*)".*/\1/' | sed -E "s|^~|$HOME|")"
  [ -n "$dir" ] || dir="$HOME/.bean"
  if [ ! -f "$dir/secrets.env" ]; then
    echo "⚠  Chưa có $dir/secrets.env — Bean chỉ resolve key từ biến môi trường." >&2
    if [ -f "$ENV_FILE" ]; then
      echo "   Key cũ đang nằm trong $ENV_FILE? Chạy một lần:" >&2
      echo "     bean --config $CONFIG config migrate-secrets --apply" >&2
    fi
  fi
}

case "${1:-start}" in
  start)
    if unit_installed; then
      # Đang có instance manual (chưa thuộc systemd)? Dừng trước để không đôi.
      if ! unit_active; then stop_all quiet; fi
      check_secrets
      systemctl --user start "$UNIT"
      systemctl --user --no-pager status "$UNIT" | head -5
      exit $?
    fi
    if [ ! -x "$BIN" ]; then
      echo "LỖI: không có binary $BIN — chạy 'make build' trong $REPO trước." >&2
      exit 1
    fi
    check_secrets
    stop_all          # luôn dừng cái cũ trước, kể cả khi không thấy pid
    launch
    sleep 3
    if pgrep -f "target/release/bean --config" >/dev/null 2>&1; then
      echo "Đã khởi động Bean (pid $(pgrep -f "target/release/bean --config" | head -1)). Log: $LOG"
      pgrep -f "target/release/bean --config" | while read -r p; do
        echo "  pid $p: $(tr '\0' ' ' </proc/$p/cmdline | sed 's|.*/||')"
      done
    else
      echo "Bean không lên — xem $LOG" >&2
      tail -15 "$LOG" >&2
      exit 1
    fi
    ;;
  stop)
    if unit_installed; then
      systemctl --user stop "$UNIT" 2>/dev/null || true
    fi
    # Còn tiến trình lẻ loi bên ngoài systemd (migration, crash cũ)? Dừng nốt.
    stop_all quiet
    ;;
  restart)
    if unit_installed; then
      if ! unit_active; then stop_all quiet; fi
      check_secrets
      systemctl --user restart "$UNIT"
      systemctl --user --no-pager status "$UNIT" | head -5
      exit $?
    fi
    check_secrets; stop_all; launch; sleep 3
    bean_pids | grep -q . && echo "Đã restart." || { echo "Không lên, xem $LOG" >&2; exit 1; } ;;
  status)
    if unit_installed; then
      # is-active/is-enabled in đúng trạng thái (active/inactive/…) và exit != 0
      # khi inactive — KHÔNG dùng `|| echo '?'` kẻo in thừa dấu ? sau trạng thái.
      echo "Unit systemd: $(systemctl --user is-enabled "$UNIT" 2>/dev/null) / $(systemctl --user is-active "$UNIT" 2>/dev/null)"
    fi
    all_pids=$(bean_pids)
    n=$(echo "$all_pids" | grep -c .)
    echo "Số tiến trình Bean: $n"
    if [ "$n" -gt 1 ]; then
      echo "⚠  Nhiều hơn một tiến trình — chạy 'beanctl restart' để gom về một."
    fi
    echo "$all_pids" | while read -r p; do
      [ -n "$p" ] || continue
      echo "  pid $p (đã chạy $(ps -o etime= -p "$p" | tr -d ' '))"
    done
    ss -ltn 2>/dev/null | grep -E '127.0.0.1:(7878|7879)' | sed 's/^/  /' || true
    ;;
  run)
    # Foreground cho `systemd --user` (deploy/systemd/bean-user.service).
    # KHÔNG setsid/disown: systemd cần process chính là con trực tiếp để quản
    # vòng đời (stop/restart/Restart=on-failure). Log đi vào journald.
    # M29: KHÔNG nạp ENV_FILE — Bean tự đọc secrets.env. DISPLAY/XAUTHORITY vẫn
    # cần fallback vì chrome MCP cần X11 (K23).
    check_secrets
    export RUST_LOG="${RUST_LOG:-info,bean_security=warn}"
    if [ -z "${DISPLAY:-}" ] && [ -d /tmp/.X11-unix ]; then export DISPLAY=:0; fi
    if [ -z "${XAUTHORITY:-}" ] && [ -f "$HOME/.Xauthority" ]; then
      export XAUTHORITY="$HOME/.Xauthority"
    fi
    # Như launch(): đường dẫn tương đối trong bean.toml giải theo CWD.
    cd "$REPO" || exit 1
    exec "$BIN" --config "$CONFIG" serve
    ;;
  *) echo "Dùng: beanctl {start|stop|restart|status|run}" >&2; exit 2 ;;
esac
