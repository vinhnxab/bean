# bean-user.service — bản systemd USER service cho máy cá nhân (khác bản
# deploy server bean.service: User=bean, /srv/bean, hardening chặt).
#
# Cài đặt:
#   cp deploy/systemd/bean-user.service ~/.config/systemd/user/bean.service
#   systemctl --user daemon-reload
#   scripts/beanctl stop                       # dừng instance manual đang chạy
#   systemctl --user enable --now bean.service
#
# Restart về sau: `beanctl restart` cũng được — script tự delegate sang systemctl
# khi unit đã cài (và nhờ vậy `bean update` M30 restart đúng qua systemd).
# Xem log:
#   journalctl --user -u bean.service -f
#
# Chạy cả khi chưa đăng nhập (bật linger cho user bean):
#   sudo loginctl enable-linger bean           # chỉ cần làm 1 lần

[Unit]
Description=Bean personal AI agent (user instance)
# 5 lần khởi động thất bại liên tiếp trong 5 phút → dừng và giữ trạng thái failed
# thay vì restart vô hạn mỗi 5s (config hỏng, port bị chiếm… sẽ nổi lên rõ ràng).
# Restart tay (beanctl restart) không cộng vào giới hạn này. LƯU Ý: hai khoá này
# thuộc [Unit], đặt trong [Service] sẽ bị systemd bỏ qua im lặng (đã dính thật).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# beanctl run: source env (dạng `export ...` mà EnvironmentFile không parse
# được), fallback DISPLAY/XAUTHORITY cho chrome MCP, rồi exec bean foreground.
ExecStart=/home/bean/dev/bean/scripts/beanctl run
# QUAN TRỌNG: Bean nạp bundled skills theo CWD (`PathBuf::from("skills")`
# trong crates/bean/src/mcp.rs), nên phải chạy đúng từ repo root.
WorkingDirectory=/home/bean/dev/bean
# Restart=always (không chỉ on-failure): SIGTERM từ tiến trình ngoài systemd
# (pkill, script khác) làm Bean exit 0 SẠCH — on-failure sẽ không restart lại,
# máy mất agent cho tới khi ai đó start tay. always che cả trường hợp này;
# `systemctl --user stop` tường minh vẫn dừng hẳn (systemd không restart sau
# lệnh stop của người vận hành). StartLimit chống crash-loop nằm ở [Unit].
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictSUIDSGID=yes

# KHÔNG dùng PrivateTmp/ProtectHome/ProtectSystem=strict/RestrictNamespaces
# cho bản user này vì:
# - chrome MCP cần X11 socket (/tmp/.X11-unix — PrivateTmp ẩn mất), profile
#   Chrome ở ~/.cache và cửa sổ GUI thật;
# - MCP server REA chạy qua npx, cần cache ~/.npm;
# - sandbox run_shell dùng docker, cần /var/run/docker.sock và mount bind.
# Đây là tradeoff chấp nhận được cho một service cá nhân chạy bằng chính user
# của người vận hành; bản deploy server (bean.service) giữ hardening đầy đủ.

[Install]
WantedBy=default.target
