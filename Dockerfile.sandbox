# Sandbox image for BeanAgent `run_shell`; deliberately contains no Node.js.
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        bash ca-certificates coreutils curl findutils git grep jq ripgrep sed \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 65534 sandbox \
    && useradd --system --uid 65532 --gid 65534 --no-create-home --shell /usr/sbin/nologin sandbox
WORKDIR /workspace
USER 65532:65534
CMD ["/bin/sh"]
